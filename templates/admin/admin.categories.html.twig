{% extends "baseadmin.html.twig" %}
{% block body %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}
    <br>  
    <div class="row">
        <div class="col-md-6">
            <table class="table table-striped" description="Toutes les catégories">


                <tbody>
                    {% for categorie in categories %}
                        <tr>
                            <td>
                                <h5 class="text-info">{{ categorie.name }}</h5>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('admin.categorie.suppr',{id:categorie.id}) }}" class="btn btn-danger" onclick="return confirm('Etes-vous sûr de vouloir supprimer {{categorie.name}} ?')">Supprimer</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h4>Ajouter une catégorie</h4>
            {{ form_start(formcategorie) }}
            {{ form_end(formcategorie) }}
        </div>
    </div>

{% endblock %}
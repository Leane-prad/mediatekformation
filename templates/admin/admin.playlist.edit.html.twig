{% extends "baseadmin.html.twig" %}
{% block body %}
    <h2>Détail playlist : </h2>
    <div class="row">
        <div class="col">
            {{ form_start(formplaylist) }}
            {{ form_end(formplaylist) }}
        </div>
        <div class="col">
            <!-- boucle sur l'affichage des formations -->
            {% for formation in playlistformations %}
                <div class="row mt-1">
                    <div class="col-md-auto">
                        {% if formation.miniature %}
                                <img src="{{ formation.miniature }}" alt="miniature de la vidéo de formation">
                        {% endif %}  
                    </div>
                    <div class="col d-flex align-items-center">
                            {{ formation.title }}          
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}